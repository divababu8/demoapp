# Copy this file to .env.local and fill in your real Supabase values
# Find these in: Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Only used server-side in API routes (upload, scan) - NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Enables fast (local, no-network-call) auth verification on every scan —
# see lib/auth.ts. Find this at: Project Settings -> API -> JWT Settings
# -> "JWT Secret". Without this set, auth checks still work correctly,
# just slower (one extra network call per request).
SUPABASE_JWT_SECRET=your-jwt-secret-here
